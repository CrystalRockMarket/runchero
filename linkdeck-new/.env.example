# LinkDeck environment. Copy to .env and fill in. Never commit real secrets.

# Core
LD_SECRET_KEY=change-me-to-a-long-random-string
LD_ADMIN_PASSWORD=change-me-admin-password
LD_DEBUG=0
LD_HOST=0.0.0.0
LD_PORT=8092
LD_FRONTEND_BASE_URL=http://localhost:8092

# Storage
# LD_DB_PATH=/home/barn/data/linkdeck.db

# Google OAuth
LD_GOOGLE_CLIENT_ID=
LD_GOOGLE_CLIENT_SECRET=
LD_GOOGLE_REDIRECT_URI=http://localhost:8092/auth/google/callback

# Facebook OAuth
LD_FACEBOOK_APP_ID=
LD_FACEBOOK_APP_SECRET=
LD_FACEBOOK_REDIRECT_URI=http://localhost:8092/auth/facebook/callback

# Magic-link email (leave blank to use the dev link fallback)
LD_SMTP_HOST=
LD_SMTP_PORT=587
LD_SMTP_USER=
LD_SMTP_PASSWORD=
LD_SMTP_TLS=1
LD_MAIL_FROM=noreply@linkdeck.local
LD_MAIL_FROM_NAME=LinkDeck
LD_MAGIC_LINK_TTL_MINUTES=15

# Features
LD_ALLOW_ANONYMOUS_OFFER=1
LD_ALLOW_REGISTRATION=1
